+    use super::format_limit_countdown;
+    use chrono::Duration;
+    use chrono::Local;
+    use pretty_assertions::assert_eq;
+
+    #[test]
+    fn usage_bar_fills_by_tenths_and_rounds_down() {
+        assert_eq!(super::usage_bar(0), "░░░░░░░░░░");
+        assert_eq!(super::usage_bar(2), "░░░░░░░░░░");
+        assert_eq!(super::usage_bar(9), "░░░░░░░░░░");
+        assert_eq!(super::usage_bar(10), "█░░░░░░░░░");
+        assert_eq!(super::usage_bar(15), "█░░░░░░░░░");
+        assert_eq!(super::usage_bar(50), "█████░░░░░");
+        assert_eq!(super::usage_bar(99), "█████████░");
+        assert_eq!(super::usage_bar(100), "██████████");
     }
+
+    #[test]
+    fn usage_bar_clamps_out_of_range_input() {
+        assert_eq!(super::usage_bar(-5), "░░░░░░░░░░");
+        assert_eq!(super::usage_bar(140), "██████████");
+    }
+
+    #[test]
+    fn past_one_day_shows_days_and_hours() {
+        let now = Local::now();
+        let resets = now + Duration::seconds(6 * 86_400 + 21 * 3_600 + 30 * 60);
+        assert_eq!(
+            format_limit_countdown(resets, now).as_deref(),
+            Some("6d 21h")
+        );
+    }
+
+    #[test]
+    fn exact_day_boundary_stays_in_days() {
+        let now = Local::now();
+        let resets = now + Duration::seconds(24 * 3_600 + 10);
+        assert_eq!(format_limit_countdown(resets, now).as_deref(), Some("1d 0h"));
+    }
+
+    #[test]
+    fn under_one_day_shows_hours_and_minutes() {
+        let now = Local::now();
+        let resets = now + Duration::seconds(20 * 3_600 + 47 * 60 + 10);
+        assert_eq!(
+            format_limit_countdown(resets, now).as_deref(),
+            Some("20h 47m")
+        );
+    }
+
+    #[test]
+    fn under_one_hour_shows_minutes_only() {
+        let now = Local::now();
+        let resets = now + Duration::seconds(47 * 60 + 5);
+        assert_eq!(format_limit_countdown(resets, now).as_deref(), Some("47m"));
+    }
+
+    #[test]
+    fn already_passed_returns_none_so_caller_falls_back() {
+        let now = Local::now();
+        assert_eq!(format_limit_countdown(now - Duration::seconds(1), now), None);
+        assert_eq!(format_limit_countdown(now, now), None);
+    }
 }
