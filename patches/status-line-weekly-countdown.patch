+/// Width of the usage meter drawn next to a limit, in cells.
+const USAGE_BAR_WIDTH: usize = 10;
+
+/// Ten-cell meter for a used percent, filled cells first (`█░░░░░░░░░`).
+///
+/// Cells round down, so a window only shows its first filled cell once it is
+/// genuinely 10% used and an almost-untouched window reads as empty.
+fn usage_bar(used_percent: i64) -> String {
+    let used = used_percent.clamp(0, 100) as usize;
+    let filled = (used * USAGE_BAR_WIDTH / 100).min(USAGE_BAR_WIDTH);
+    (0..USAGE_BAR_WIDTH)
+        .map(|cell| if cell < filled { '█' } else { '░' })
+        .collect()
+}
+
+/// Time left until a usage window resets, in English short units.
+///
+/// Past one day it degrades to whole days and hours (`6d 21h`) because the
+/// status line is not redrawn every second; below a day it keeps minutes
+/// (`20h 47m`, `47m`). Returns `None` once the instant has passed.
+fn format_limit_countdown(
+    resets_at: chrono::DateTime<chrono::Local>,
+    now: chrono::DateTime<chrono::Local>,
+) -> Option<String> {
+    const SECONDS_PER_MINUTE: i64 = 60;
+    const SECONDS_PER_HOUR: i64 = 60 * SECONDS_PER_MINUTE;
+    const SECONDS_PER_DAY: i64 = 24 * SECONDS_PER_HOUR;
+
+    let seconds = resets_at.signed_duration_since(now).num_seconds();
+    if seconds <= 0 {
+        return None;
+    }
+    let days = seconds / SECONDS_PER_DAY;
+    let hours = (seconds % SECONDS_PER_DAY) / SECONDS_PER_HOUR;
+    let minutes = (seconds % SECONDS_PER_HOUR) / SECONDS_PER_MINUTE;
+    Some(if days > 0 {
+        format!("{days}d {hours}h")
+    } else if hours > 0 {
+        format!("{hours}h {minutes}m")
+    } else {
+        format!("{minutes}m")
+    })
+}
