+/// Headroom bands for quota-like items (5h/weekly limits and context usage).
+///
+/// Bands use the used percent so `N% left` and `N% used` share one scale:
+/// under 50% used is healthy, 50% warns, 70% is high, and 85% used (15% or
+/// less remaining) is critical.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum UsageLevel {
+    Healthy,
+    Warn,
+    High,
+    Critical,
+}
+
+impl UsageLevel {
+    fn from_used_percent(used: i64) -> Self {
+        if used >= 85 {
+            Self::Critical
+        } else if used >= 70 {
+            Self::High
+        } else if used >= 50 {
+            Self::Warn
+        } else {
+            Self::Healthy
+        }
+    }
+
+    #[allow(clippy::disallowed_methods)]
+    fn color(self) -> Color {
+        match self {
+            Self::Healthy => Color::Rgb(63, 185, 80),
+            Self::Warn => Color::Rgb(210, 153, 34),
+            Self::High => Color::Rgb(240, 136, 62),
+            Self::Critical => Color::Rgb(248, 81, 73),
+        }
+    }
+}
+
+/// Reads the used percent from quota-like segments rendered as `5h 84% left`,
+/// `weekly 97% left`, `Context 12% used`, or `Context 88% left`.
+///
+/// Returns `None` for other items or unexpected text so they keep theme colors.
+fn used_percent_for_segment(item: StatusLineItem, text: &str) -> Option<i64> {
+    if !matches!(
+        item,
+        StatusLineItem::FiveHourLimit
+            | StatusLineItem::WeeklyLimit
+            | StatusLineItem::ContextUsed
+            | StatusLineItem::ContextRemaining
+    ) {
+        return None;
+    }
+    let (head, tail) = text.rsplit_once('%')?;
+    let percent: i64 = head.rsplit(' ').next()?.parse().ok()?;
+    let used = match tail.trim() {
+        "used" => percent,
+        "left" => 100 - percent,
+        _ => return None,
+    };
+    Some(used.clamp(0, 100))
+}
